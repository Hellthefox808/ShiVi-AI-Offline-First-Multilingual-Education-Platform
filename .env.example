# ==============================================================================
# BhashaSetu AI — Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# NEVER commit actual secrets, private keys, or API tokens to version control.
# ==============================================================================

# --- 1. Web Backend Gateway (NestJS 11) ---
PORT=3001
NODE_ENV=development
# Database Connection String (PostgreSQL with pgvector)
DATABASE_URL=postgresql://bhashasetu_user:bhashasetu_password@localhost:5432/bhashasetu_db
# Task Queue & Cache Connection (Redis 7+)
REDIS_URL=redis://localhost:6379
# Internal URL of the AI Platform microservice
AI_PLATFORM_URL=http://localhost:8000
# HMAC/JWT Signing Secret (Must be changed in production)
JWT_SECRET=replace_with_a_secure_random_secret_min_32_chars
# Persistence mode: 'filesystem' (default durable storage) or 'memory' (for isolated testing)
BHASHASETU_PERSISTENCE=filesystem
# Local directory for durable sync storage and cached lesson packages
BHASHASETU_DATA_DIR=./data/persistence

# --- 2. AI Platform Microservice (FastAPI + Python 3.12) ---
AI_PORT=8000
PYTHONUNBUFFERED=1
RAG_EMBEDDING_MODEL=BAAI/bge-m3
LOG_LEVEL=info

# --- 3. Web Frontend (Next.js 16.3 + React 19) ---
# Note: Use port 3002 on local Windows machines to avoid host collisions
FRONTEND_PORT=3002
# Publicly accessible backend API gateway endpoint
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# --- 4. Android Edge & Cloud Fallback ---
# Optional: Google Gemini API key for online pedagogical fallback when internet is available
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
